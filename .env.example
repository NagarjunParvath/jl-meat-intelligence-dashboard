# Copy this file to .env and fill in your real keys. Never commit .env to git.

# USDA MPR DataMart API — mymarketnews.ams.usda.gov
USDA_MPR_API_KEY=your-key-here

# Anthropic API — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-key-here

# Bureau of Labor Statistics — bls.gov/developers
BLS_API_KEY=your-key-here

# Finnhub — finnhub.io/dashboard
FINNHUB_API_KEY=your-key-here

# USDA NASS QuickStats — quickstats.nass.usda.gov/api (free registration)
# Used by fetch_drought_data.py for TX pasture conditions
NASS_API_KEY=your-key-here

# NOAA Climate Data Online — www.ncei.noaa.gov/cdo-web/token (free, instant)
# Used by fetch_drought_data.py for PDSI + precip/temp anomalies
NOAA_CDO_TOKEN=your-token-here
