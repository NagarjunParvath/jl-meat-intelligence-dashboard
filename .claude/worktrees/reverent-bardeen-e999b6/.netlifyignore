# Secrets
.env
.env.*

# Python pipeline scripts — not needed by the static site
*.py
*.bat

# Large training dataset — dashboard reads latest.json + forecasts.json only
data/history.json

# Logs and temp artefacts
update.log
*.log
__pycache__/
.tmp/

# Word / developer docs
*.docx
ARCHITECTURE.md
README_USDA_UPDATER.md

# Git internals
.git/
.gitignore
